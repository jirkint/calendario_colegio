# Copia este archivo como `.env` y ajusta los valores.

# URL de tu base de datos PostgreSQL.
# Si usas `docker compose up -d`, deja la URL del contenedor (puerto 5433).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/edupaz

# Secreto para firmar los tokens de sesión. Cámbialo en producción.
JWT_SECRET=cambia-este-secreto-en-produccion

# Código que necesitan los profesores para registrarse.
# Si lo dejás vacío, el registro queda abierto.
INVITE_CODE=EDUPAZ2026

# Puerto del servidor API (por defecto 3001).
PORT=3001
